{
    "defs": {
        "main": {
            "description": "Account experiment",
            "key": "tid",
            "record": {
                "properties": {
                    "createdAt": {
                        "format": "datetime",
                        "type": "string"
                    },
                    "actor": {
                        "refs": [
                            "app.bsky.actor.defs#profileViewDetailed",
                            "net.atview.experimental.managedprofile"
                        ],
                        "description": "Reference to a user's profile or managed profile",
                        "type": "union"
                    },
                    "type": {
                        "type": "string",
                        "description": "Type of the account",
                        "knownValues": [
                            "project",
                            "user",
                            "organisation",
                            "collective"
                        ],
                        "default": "user",
                        "maxLength": 640,
                        "maxGraphemes": 64
                    },
                    "overrides": {
                        "type": "ref",
                        "ref": "#overrides",
                        "description": "Overrides for the profile"
                    }
                },
                "required": [
                    "createdAt",
                    "actor"
                ],
                "type": "object"
            },
            "type": "record"
        },
        "overrides": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "maxLength": 640,
                    "maxGraphemes": 64
                },
                "description": {
                    "type": "string",
                    "maxLength": 2560,
                    "maxGraphemes": 256
                },
                "avatar": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                }
            },
            "additionalProperties": false
        }
    },
    "id": "net.atview.experimental.account",
    "lexicon": 1
}