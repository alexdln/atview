{
  "name": "@atview/react",
  "version": "0.0.1",
  "description": "React tools for atproto text-based content",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.mjs"
    },
    "./default": {
      "types": "./dist/cjs/default.d.ts",
      "import": "./dist/esm/default.mjs",
      "require": "./dist/cjs/default.js",
      "default": "./dist/esm/default.mjs"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "atproto",
    "react",
    "tools"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/alexdln/atview.git"
  },
  "author": {
    "name": "Alex Savelyev",
    "email": "dev@alexdln.com",
    "url": "https://github.com/alexdln/"
  },
  "license": "MIT",
  "devDependencies": {
    "@atview/core": "./atview-core-0.0.1.tgz",
    "@rollup/plugin-commonjs": "29.0.2",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "react": "19.2.4",
    "rollup": "4.59.0",
    "rollup-preserve-directives": "1.1.3",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@atview/core": ">= 0.0.1",
    "react": ">= 19.1.0"
  }
}